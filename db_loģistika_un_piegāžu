--------------------------------------------------Vaicājumi
--A. Vienkārši SELECT (7)
SELECT * from Marsruti; -- Atlasa visus maršrutus
SELECT * from Klienti; -- Atlasa visus klientus
seleCt * FROM Kurjeri; -- Atlasa visus kurjerus
SELECT * FROM Transportlidzekli; -- Atlasa visus transportlīdzekļus
SELECT * FROM Sutijumi; -- Atlasa visus sūtījumus
SELECT * FROM Piegades; -- Atlasa visas piegādes
SELECT * FROM Maksajumi; -- Atlasa visus maksājumus

--B. WHERE filtrēšana (10)
SELECT * FROM Klienti WHERE pilseta = 'Jelgava'; -- Atrod klientus, kas dzīvo Jelgavā
SELECT * FROM Sutijumi WHERE svars_kg >= 70.00; -- Atrod sūtījumus, kas smagāki par 70kg
SELECT * FROM Kurjeri WHERE statuss = 'Atvaļinājumā'; -- Atrod kurjerus atvaļinājumā
SELECT * FROM Maksajumi WHERE summa <= 10.00; -- Atrod maksājumus līdz 10 eiro
SELECt * FROM Sutijumi WHERE reg_datums <= '2026-05-05'; -- Atrod sūtījumus līdz noteiktam datumam
SELECT * FROM Transportlidzekli WHERE ir_darba_kartiba = 0; -- Atrod transportus, kas nedarbojas
SELECT * FROM Piegades WHERE statuss = 'Kavējas'; -- Atrod piegādes, kas kavējas
SELECt * FROM Transportlidzekli WHERE tips = 'Vieglais auto'; -- Atrod visus vieglos auto
SELECT * FROM Marsruti WHERE piegades_laiks_dienas >= 3; -- Atrod maršrutus ar ilgu piegādi
SELECT * FROM Maksajumi WHERE statuss = 'Nav apmaksāts'; -- Atrod visus neapmaksātos rēķinus

--C. ORDER BY (6)
SELECT uzvards FROM Klienti ORDER BY vards ASC; -- Kārto uzvārdus pēc vārda alfabēta
SELECT * FROM Sutijumi ORDER BY svars_kg DESC; -- Kārto sūtījumus pēc svara no lielākā
SELECT sutijums_id, summa FROM Maksajumi ORDER BY summa DESC; -- Kārto maksājumus pēc summas no lielākās
SELECT * FROM Piegades ORDER BY izsniegsanas_datums DESC; -- Kārto piegādes pēc jaunākā datuma
SELECT * FROM Transportlidzekli ORDER BY ietilpiba_kg DESC; -- Kārto transportu pēc ietilpības
SELECT * FROM Kurjeri ORDER BY piegazu_limits DESC; -- Kārto kurjerus pēc lielākā limita

--D. JOIN (12)
SELECT Klienti.vards, Klienti.uzvards, Sutijumi.reg_datums
FROM Sutijumi
JOIN Klienti ON Sutijumi.klients_id = Klienti.klients_id; -- Savieno sūtījumus ar klientu datiem

SELECT Sutijumi.sutijums_id,Sutijumi.saturs, Marsruti.regiona_nos,Marsruti.piegades_laiks_dienas
FROM Sutijumi
JOIN Marsruti ON Sutijumi.marsruts_id = Marsruti.marsruts_id; -- Savieno sūtījumus ar reģionu datiem

SELECT Piegades.piegade_id, Kurjeri.vards,Kurjeri.uzvards, Transportlidzekli.tips AS transports
FROM Piegades
JOIN Kurjeri ON Piegades.kurjers_id = Kurjeri.kurjers_id
JOIN Transportlidzekli ON Piegades.transports_id = Transportlidzekli.transports_id; -- Savieno piegādes ar kurjeru un transportu

SELECT Piegades.piegade_id, Transportlidzekli.tips AS Transports, Transportlidzekli.valsts_numurs
FROM Piegades
JOIN Transportlidzekli ON Piegades.transports_id = Transportlidzekli.transports_id; -- Parāda transporta numuru piegādēm

SELECT Klienti.klients_id, Sutijumi.saturs as sutijuma_saturs, Maksajumi.summa, Maksajumi.veids AS maksajuma_veids
FROM Sutijumi
Join Klienti On Klienti.klients_id = Sutijumi.klients_id
JOIN Maksajumi On Maksajumi.sutijums_id = Sutijumi.sutijums_id; -- Savieno klientu, sūtījumu un maksājumu kopā

SELECT Sutijumi.sutijums_id, Kurjeri.uzvards, Piegades.statuss
FROM Piegades
JOIN Sutijumi ON Piegades.sutijums_id = Sutijumi.sutijums_id
JOIN Kurjeri ON Piegades.kurjers_id = Kurjeri.kurjers_id; -- Savieno sūtījumus ar kurjera uzvārdu un statusu

SELECT Piegades.piegade_id, Transportlidzekli.tips, Piegades.statuss 
FROM Piegades 
JOIN Transportlidzekli ON Piegades.transports_id = Transportlidzekli.transports_id WHERE Piegades.statuss = 'Ceļā'; -- Atrod transporta tipu piegādēm ceļā

SELECT Klienti.vards, Klienti.uzvards, Marsruti.regiona_nos
FROM Sutijumi
JOIN Klienti ON Sutijumi.klients_id = Klienti.klients_id
JOIN Marsruti ON Sutijumi.marsruts_id = Marsruti.marsruts_id WHERE Marsruti.regiona_nos = 'Kurzeme'; -- Atrod Kurzemei piesaistītos klientus

SELECT Piegades.piegade_id, Klienti.uzvards AS Klients, Kurjeri.uzvards AS Kurjers, Transportlidzekli.valsts_numurs, Piegades.statuss
FROM Piegades
JOIN Sutijumi ON Piegades.sutijums_id = Sutijumi.sutijums_id
JOIN Klienti ON Sutijumi.klients_id = Klienti.klients_id
JOIN Kurjeri ON Piegades.kurjers_id = Kurjeri.kurjers_id
JOIN Transportlidzekli ON Piegades.transports_id = Transportlidzekli.transports_id; -- Pilns un detalizēts loģistikas pārskats

SELECT Maksajumi.maksajums_id, Maksajumi.summa, Maksajumi.veids
FROM Maksajumi
JOIN Sutijumi ON Maksajumi.sutijums_id = Sutijumi.sutijums_id WHERE Maksajumi.veids = 'Kredītkarte'; -- Parāda kredītkaršu maksājumu datus

SELECT Maksajumi.maksajums_id, Klienti.uzvards, Maksajumi.summa 
FROM Maksajumi 
JOIN Sutijumi ON Maksajumi.sutijums_id = Sutijumi.sutijums_id 
JOIN Klienti ON Sutijumi.klients_id = Klienti.klients_id; -- Parāda, kurš klients veica konkrētu maksājumu

SELECT Sutijumi.sutijums_id, Marsruti.piegades_cena 
FROM Sutijumi 
JOIN Marsruti ON Sutijumi.marsruts_id = Marsruti.marsruts_id WHERE Marsruti.piegades_cena > 20.00; -- Parāda dārgos sūtījumu maršrutus

--E. Agregācijas (10)
SELECT COUNT(*) AS kopejais_klientu_skaits FROM Klienti; -- Saskaita kopējos klientus
SELECT COUNT(*) AS kopejais_kurjeru_skaits FROM Kurjeri; -- Saskaita kopējos kurjerus
SELECT AVG(svars_kg) AS videjais_sutijuma_svars FROM Sutijumi; -- Aprēķina vidējo sūtījuma svaru
SELECT MAX(piegades_cena) AS maksimāla_piegādes_cena FROM Marsruti; -- Atrod visdārgāko cenu maršrutos
SELECT MIN(piegades_cena) AS minimala_piegades_cena FROM Marsruti; -- Atrod viszemāko cenu maršrutos
SELECT SUM(summa) AS kopeja_ieņemumu_summa FROM Maksajumi WHERE statuss = 'Apmaksāts'; -- Aprēķina kopējos ieņēmumus
SELECT pilseta, COUNT(*) AS klientu_skaits_pilseta FROM Klienti GROUP BY pilseta; -- Saskaita klientus pa pilsētām
SELECT statuss, COUNT(*) AS piegazu_skaits_statusa FROM Piegades GROUP BY statuss; -- Saskaita piegādes pa statusiem
SELECT veids, AVG(summa) AS videja_summa_veidam FROM Maksajumi GROUP BY veids; -- Aprēķina vidējo maksājumu katram veidam
SELECT tips, MAX(ietilpiba_kg) AS maksimala_ietilpiba FROM Transportlidzekli GROUP BY tips; -- Atrod lielāko ietilpību katram transporta tipam

--F. UPDATE (5)
SELECT * FROM Transportlidzekli WHERE transports_id = 8; -- 1. Pārbauda transportu Nr. 8 pirms labošanas
UPDATE Transportlidzekli SET ir_darba_kartiba = 1 WHERE transports_id = 8; -- 1. Atzīmē transportu Nr. 8 kā salabotu
SELECT * FROM Transportlidzekli WHERE transports_id = 8; -- 1. Pārbauda transportu Nr. 8 pēc labošanas

SELECT * FROM Kurjeri WHERE kurjers_id = 3; -- 2. Pārbauda kurjeru Nr. 3 pirms statusa maiņas
UPDATE Kurjeri SET statuss = 'Aktīvs' WHERE kurjers_id = 3; -- 2. Nomaina statusu uz Aktīvs kurjeram Nr. 3
SELECT * FROM Kurjeri WHERE kurjers_id = 3; -- 2. Pārbauda kurjeru Nr. 3 pēc statusa maiņas

SELECT * FROM Marsruti WHERE marsruts_id = 1; -- 3. Pārbauda maršrutu Nr. 1 pirms cenas maiņas
