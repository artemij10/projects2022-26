-- Loģistikas un piegāžu uzņēmuma datu bāze
-- Vārds Uzvārds: Artjoms Sideļovs P24-1

DROP TABLE IF EXISTS Maksajumi;
DROP TABLE IF EXISTS Piegades;
DROP TABLE IF EXISTS Sutijumi;
DROP TABLE IF EXISTS Transportlidzekli;
DROP TABLE IF EXISTS Kurjeri;
DROP TABLE IF EXISTS Klienti;
DROP TABLE IF EXISTS Marsruti;

-- 1. Marsruti
CREATE TABLE Marsruti (
  marsruts_id INTEGER PRIMARY KEY AUTOINCREMENT,
  regiona_nos VARCHAR(50) NOT NULL,
  piegades_cena DECIMAL(10,2) NOT NULL CHECK(piegades_cena >= 0),
  piegades_laiks_dienas INTEGER NOT NULL DEFAULT 2
);

-- 2. Klienti
CREATE TABLE Klienti (
  klients_id INTEGER PRIMARY KEY AUTOINCREMENT,
  vards VARCHAR(50) NOT NULL,
  uzvards VARCHAR(50) NOT NULL,
  epasts VARCHAR(50) UNIQUE NOT NULL,
  talrunis VARCHAR(20) NOT NULL,
  pilseta VARCHAR(50) NOT NULL,
  adrese TEXT NOT NULL
);

-- 3. Kurjeri
CREATE TABLE Kurjeri (
  kurjers_id INTEGER PRIMARY KEY AUTOINCREMENT,
  vards VARCHAR(50) NOT NULL,
  uzvards VARCHAR(50) NOT NULL,
  talrunis VARCHAR(20) UNIQUE NOT NULL,
  statuss VARCHAR(20) NOT NULL DEFAULT 'Aktīvs',
  piegazu_limits INTEGER NOT NULL CHECK(piegazu_limits >= 0)
);

-- 4. Transportlidzekli
CREATE TABLE Transportlidzekli (
  transports_id INTEGER PRIMARY KEY AUTOINCREMENT,
  valsts_numurs VARCHAR(15) UNIQUE NOT NULL,
  tips VARCHAR(30) NOT NULL,
  ietilpiba_kg DECIMAL(10, 2) NOT NULL CHECK(ietilpiba_kg > 0),
  ir_darba_kartiba BOOLEAN NOT NULL DEFAULT 1
);

-- 5. Sutijumi
CREATE TABLE Sutijumi (
  sutijums_id INTEGER PRIMARY KEY AUTOINCREMENT,
  klients_id INTEGER NOT NULL,
  marsruts_id INTEGER NOT NULL,
  svars_kg DECIMAL(10, 2) NOT NULL CHECK(svars_kg > 0),
  saturs VARCHAR(100) NOT NULL,
  reg_datums DATE NOT NULL,
  FOREIGN KEY (klients_id) REFERENCES Klienti(klients_id),
  FOREIGN KEY (marsruts_id) REFERENCES Marsruti(marsruts_id)
);

-- 6. Piegades
CREATE TABLE Piegades (
  piegade_id INTEGER PRIMARY KEY AUTOINCREMENT,
  sutijums_id INTEGER NOT NULL UNIQUE,
  kurjers_id INTEGER NOT NULL,
  transports_id INTEGER NOT NULL,
  izsniegsanas_datums DATE NOT NULL,
  faktiskais_datums DATE,
  statuss VARCHAR(30) NOT NULL DEFAULT 'Apstrādē',
  FOREIGN KEY (sutijums_id) REFERENCES Sutijumi(sutijums_id),
  FOREIGN KEY (kurjers_id) REFERENCES Kurjeri(kurjers_id),
  FOREIGN KEY (transports_id) REFERENCES Transportlidzekli(transports_id)
);

-- 7. Maksajumi
CREATE TABLE Maksajumi (
  maksajums_id INTEGER PRIMARY KEY AUTOINCREMENT,
  sutijums_id INTEGER NOT NULL,
  summa DECIMAL(10, 2) NOT NULL CHECK(summa > 0),
  maksajuma_datums DATE NOT NULL,
  veids VARCHAR(30) NOT NULL,
  statuss VARCHAR(20) NOT NULL DEFAULT 'Apmaksāts',
  FOREIGN KEY (sutijums_id) REFERENCES Sutijumi(sutijums_id)
);

